{
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyeokjinKang/URLATE-v3l-game.git"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "name": "urlate-v3l-game",
  "version": "1.0.0",
  "description": "Socket.IO based game server for URLATE",
  "main": "src/",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "auto-build": "tsc-watch",
    "dev": "supervisor dist/index.js",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop URLATE-v3l-game",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Coupy",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "bugs": {
    "url": "https://github.com/HyeokjinKang/URLATE-v3l-game/issues"
  },
  "dependencies": {
    "connect-redis": "^9.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "redis": "^5.12.1",
    "signale": "^1.4.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.3",
    "@types/signale": "^1.4.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supervisor": "^0.12.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
